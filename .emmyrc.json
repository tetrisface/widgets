{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.1",
    "requirePattern": ["?", "?.lua"],
    "requireLikeFunction": ["VFS.Include", "include"]
  },
  "completion": {
    "autoRequireSeparator": "/"
  },
  "workspace": {
    "library": ["recoil-lua-library/library"],
    "ignoreDir": [".vscode", ".git", ".jj", ".codegraph", ".cachebro", ".plans", ".noload"]
  },
  "diagnostics": {
    "disable": ["duplicate-set-field"],
    "globals": [
      "Spring",
      "VFS",
      "gl",
      "GL",
      "Game",
      "Script",
      "Platform",
      "Engine",
      "COB",
      "CMD",
      "CMDTYPE",
      "COBSCALE",
      "KEYSYMS",
      "LOG",
      "SYNCED",
      "UnitDefs",
      "UnitDefNames",
      "FeatureDefs",
      "FeatureDefNames",
      "WeaponDefs",
      "WeaponDefNames",
      "ExplosionDefs",
      "GL_TEXTURE_2D",
      "GL_HINT_BIT",
      "WG",
      "widget",
      "widgetHandler",
      "GG",
      "gadget",
      "gadgetHandler",
      "fontHandler",
      "handler",
      "addon",
      "LUAUI_DIRNAME",
      "self",
      "include",
      "SendToUnsynced",
      "CallAsTeam",
      "lowerkeys",
      "pairsByKeys",
      "loadlib",
      "gcinfo",
      "socket",
      "Chili",
      "screen0",
      "Checkbox",
      "Control",
      "ComboBox",
      "Button",
      "Label",
      "Line",
      "EditBox",
      "Font",
      "Window",
      "ScrollPanel",
      "LayoutPanel",
      "Panel",
      "StackPanel",
      "Grid",
      "TextBox",
      "Image",
      "TreeView",
      "Trackbar",
      "DetachableTabPanel",
      "Progressbar"
    ]
  }
}
